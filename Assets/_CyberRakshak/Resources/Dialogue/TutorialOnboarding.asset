  m_Script: {fileID: 11500000, guid: ea2b9b24b6705ec4b91b230eb6a29e87, type: 3}
  m_Name: TutorialOnboarding
  m_EditorClassIdentifier: CyberRakshak::CyberRakshak.PATCH.PatchDialogueSequence
  useOfficeBackdrop: 1
  messages:
  - speaker: JAY
    text: Adi, welcome to CyberRakshak. Before your first assignment, we will run
      an authorised training simulation.
    displaySeconds: 4
  - speaker: ADI
    text: Understood. Who will guide me through it?
    displaySeconds: 4
  - speaker: PATCH
    text: I am PATCH, your onboarding assistant. Move with WASD, look with the mouse,
      and jump with SPACE. Let us practise.
    displaySeconds: 4
